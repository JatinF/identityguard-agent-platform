{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadPlaceholderExecution",
      "Effect": "Allow",
      "Action": ["states:StartExecution", "states:DescribeExecution"],
      "Resource": "arn:aws:states:us-east-1:000000000000:stateMachine:identityguard"
    },
    {
      "Sid": "InvokePlaceholderFunctions",
      "Effect": "Allow",
      "Action": ["lambda:InvokeFunction"],
      "Resource": [
        "arn:aws:lambda:us-east-1:000000000000:function:identityguard-policy",
        "arn:aws:lambda:us-east-1:000000000000:function:identityguard-approval",
        "arn:aws:lambda:us-east-1:000000000000:function:identityguard-tool",
        "arn:aws:lambda:us-east-1:000000000000:function:identityguard-verify"
      ]
    }
  ]
}
