{
  "Comment": "Durable skeleton for the identityguard harness. Account 000000000000 is a documentation placeholder. This state machine has not been created in AWS.",
  "StartAt": "Intake",
  "TimeoutSeconds": 86400,
  "States": {
    "Intake": {
      "Type": "Pass",
      "Next": "Policy"
    },
    "Policy": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:us-east-1:000000000000:function:identityguard-policy",
      "ResultPath": "$.policy",
      "Next": "Route",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "Close"
        }
      ]
    },
    "Route": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.policy.decision",
          "StringEquals": "deny",
          "Next": "Close"
        },
        {
          "Variable": "$.policy.decision",
          "StringEquals": "needs-approval",
          "Next": "WaitForApproval"
        },
        {
          "Variable": "$.policy.decision",
          "StringEquals": "allow",
          "Next": "Execute"
        }
      ],
      "Default": "Close"
    },
    "WaitForApproval": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "TimeoutSeconds": 86400,
      "Parameters": {
        "FunctionName": "arn:aws:lambda:us-east-1:000000000000:function:identityguard-approval",
        "Payload": {
          "task_token.$": "$$.Task.Token",
          "request_id.$": "$.request_id",
          "tenant.$": "$.tenant",
          "operation.$": "$.operation"
        }
      },
      "ResultPath": "$.approval",
      "Next": "Recheck",
      "Catch": [
        {
          "ErrorEquals": ["States.Timeout", "States.TaskFailed"],
          "Next": "Close"
        }
      ]
    },
    "Recheck": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:us-east-1:000000000000:function:identityguard-policy",
      "ResultPath": "$.policy",
      "Next": "RouteAfterApproval",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "Close"
        }
      ]
    },
    "RouteAfterApproval": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.policy.decision",
          "StringEquals": "allow",
          "Next": "Execute"
        }
      ],
      "Default": "Close"
    },
    "Execute": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:us-east-1:000000000000:function:identityguard-tool",
      "ResultPath": "$.tool_result",
      "Next": "Verify",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "Close"
        }
      ]
    },
    "Verify": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:us-east-1:000000000000:function:identityguard-verify",
      "ResultPath": "$.verification",
      "Next": "Close",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "Close"
        }
      ]
    },
    "Close": {
      "Type": "Pass",
      "End": true
    }
  }
}
